# Safe, explicit local demonstration mode: Gemini is not invoked.
IPROMISE_MODE=demonstration
IPROMISE_COMPILER=deterministic
IPROMISE_DEMO_BASE_URL=http://127.0.0.1:8081
IPROMISE_DEMO_TOKEN=replace-with-the-same-long-random-value-as-demo-saas
IPROMISE_AGENT_API_TOKEN=
IPROMISE_EXECUTION_TARGET=local-process
IPROMISE_STATE_BACKEND=memory
IPROMISE_CONSOLE_BASE_URL=http://127.0.0.1:3000
IPROMISE_GITHUB_ACTIONS_ENABLED=false
IPROMISE_GITHUB_APP_ID=
IPROMISE_GITHUB_APP_SLUG=
IPROMISE_GITHUB_APP_CLIENT_ID=
IPROMISE_GITHUB_APP_CLIENT_SECRET=
IPROMISE_GITHUB_APP_PRIVATE_KEY=
PORT=8080

# Real hackathon cloud mode (requires `uv sync --extra google` and Vertex ADC):
# IPROMISE_MODE=cloud
# IPROMISE_COMPILER=adk
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-dedicated-ipromise-project
# GOOGLE_CLOUD_LOCATION=us-central1
# IPROMISE_GEMINI_MODEL=gemini-3.5-flash
# IPROMISE_STATE_BACKEND=firestore
# IPROMISE_FIRESTORE_DATABASE=(default)
# IPROMISE_GOOGLE_OIDC_AUDIENCE=https://ipromise-agent-xxxxx.run.app
# IPROMISE_SCHEDULER_SERVICE_ACCOUNT=ipromise-scheduler@project.iam.gserviceaccount.com
