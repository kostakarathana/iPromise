# Local integration (copy only the relevant values into each service's env file)
IPROMISE_AGENT_URL=http://127.0.0.1:8080
# Agent-side bearer and the console-side copy of the same secret. In Cloud Run,
# mount both from the single ipromise-agent-api-token Secret Manager version.
IPROMISE_AGENT_API_TOKEN=
IPROMISE_AGENT_TOKEN=
IPROMISE_DEMO_BASE_URL=http://127.0.0.1:8081
IPROMISE_DEMO_TOKEN=replace-with-a-long-random-value
IPROMISE_MODE=demonstration
IPROMISE_COMPILER=deterministic
IPROMISE_EXECUTION_TARGET=local-process
IPROMISE_STATE_BACKEND=memory
IPROMISE_CONSOLE_BASE_URL=http://127.0.0.1:3000

# Required for the eligible cloud submission
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ipromise-hackathon
# Gemini 3.5 Flash supports global/us/eu and selected named regions, not us-central1.
GOOGLE_CLOUD_LOCATION=global
IPROMISE_GEMINI_MODEL=gemini-3.5-flash

# Configure through Secret Manager in Google Cloud. Never commit real values.
# The console access token must contain 32 to 256 characters.
IPROMISE_CONSOLE_ACCESS_TOKEN=
IPROMISE_GITHUB_ACTIONS_ENABLED=false
IPROMISE_GITHUB_APP_ID=
IPROMISE_GITHUB_APP_SLUG=
IPROMISE_GITHUB_APP_CLIENT_ID=
# Supply the two values below only through local ignored env files or Secret Manager.
IPROMISE_GITHUB_APP_CLIENT_SECRET=
IPROMISE_GITHUB_APP_PRIVATE_KEY=
IPROMISE_VERIFIER_BACKEND=disabled
IPROMISE_CLOUD_BUILD_PROJECT=
IPROMISE_CLOUD_BUILD_LOCATION=australia-southeast1
IPROMISE_CLOUD_BUILD_SERVICE_ACCOUNT=
IPROMISE_FIRESTORE_DATABASE=(default)
IPROMISE_GOOGLE_OIDC_AUDIENCE=
IPROMISE_SCHEDULER_SERVICE_ACCOUNT=
IPROMISE_ESCALATION_EMAIL=
