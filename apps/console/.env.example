# Optional. When absent, the console runs a clearly labeled local demonstration.
IPROMISE_AGENT_URL=http://localhost:8080

# Optional bearer token sent only by the server-side proxy.
IPROMISE_AGENT_TOKEN=

# Optional locally; required for a public Cloud Run console. This server-only
# value protects the judge UI and mutation routes. Use a random value with at
# least 32 characters and share it only through the Devpost testing instructions.
IPROMISE_CONSOLE_ACCESS_TOKEN=
